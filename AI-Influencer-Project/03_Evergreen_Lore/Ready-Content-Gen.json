    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "Sana verilen manifestoyu TikTok/Shorts algoritmaları için kusursuz bir üretim paketine çevir.\n\nSTRICT JSON ver:\n{\n  \"video_hook\": \"İlk 3 saniye vurucu başlık\",\n  \"teleprompter_script\": \"Kamera ve mimik komutları içeren akıcı senaryo\",\n  \"caption_hashtags\": \"Açıklama ve hashtagler\",\n  \"visual_prompt\": \"Midjourney/Flux görsel üretim promptu\"\n}",
              "role": "system"
            },
            {
              "content": "={{ $json.message.content }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.7
        }
      },
