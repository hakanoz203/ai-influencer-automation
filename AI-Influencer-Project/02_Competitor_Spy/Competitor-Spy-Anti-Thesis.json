        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer OPEN_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sen alemin gördüğü en sert ton yargıcısın. Verilen metin 'acımasız, otoriter, sert, tokat gibi, kurban psikolojisine karşı' bir ilişki mentörü manifestosu olmalı. Yumuşak, dengeli, politik doğrucu, klişe veya 'iletişim/saygı/anlayış' tavsiyesi veriyorsa düşük puan. SADECE bu JSON şemasında döndür: {\\\"score\\\": number (1-10), \\\"verdict\\\": string, \\\"reason\\\": string}. 7 ve üstü sert kabul edilir, 6 ve altı yumuşak.\"\n    },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify($json.manifesto) }} }\n  ]\n}\n",
