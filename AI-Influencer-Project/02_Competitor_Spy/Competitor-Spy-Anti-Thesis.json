    {
      "parameters": {
        "jsCode": "// Transcript budama: etiket temizliği, intro/outro kırp, 2000 kelime sınırı\nconst raw = $input.first().json.content || $input.first().json.transcript || '';\nconst videoId = $('Extract videoId').item.json.videoId;\nconst videoTitle = $('Extract videoId').item.json.videoTitle;\nconst channelName = $('Extract videoId').item.json.Channel_Name;\n\n// 1) Otomatik etiketleri sil: [müzik], [alkış], [Music], [Applause], (music), vb.\nlet text = raw\n  .replace(/\\[[^\\]]{1,40}\\]/g, ' ')\n  .replace(/\\([^\\)]{1,40}\\)/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// 2) Kelimelere böl\nlet words = text.split(/\\s+/).filter(Boolean);\nconst originalCount = words.length;\n\n// 3) Intro/outro kırpma: ilk 100 + son 100 kelimeyi at (çok kısa videoda atla)\nif (words.length > 300) {\n  words = words.slice(100, words.length - 100);\n}\n\n// 4) 2000 kelime sınırı: aşarsa ortadan kes (ilk 1000 + son 1000)\nif (words.length > 2000) {\n  const head = words.slice(0, 1000);\n  const tail = words.slice(words.length - 1000);\n  words = [...head, '...', ...tail];\n}\n\nconst cleaned = words.join(' ');\n\nreturn [{\n  json: {\n    videoId,\n    videoTitle,\n    channelName,\n    cleaned_transcript: cleaned,\n    word_count: words.length,\n    original_word_count: originalCount\n  }\n}];"
      },
      "id": "0a59b2bc-2ff6-4a63-843d-1012501fda45",
      "name": "JS: Transcript Budama",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        816
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer OPENAI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.7,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sen acımasız bir rakip analistisin. Sana verilen metin, ilişkiler üzerine tavsiye veren rakip bir YouTuber'a ait. Bu videonun 'Ana Fikrini (Tezini)' bul. Bu tezin neden toksik, zayıf, kurban psikolojisini besleyen veya bir yaklaşım olduğunu tespit et. SADECE şu JSON şemasında Türkçe cevap ver: {\\\"rakip_tezi\\\": string, \\\"toplumsal_itiraz_noktasi\\\": string}. Açıklama ekleme.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.cleaned_transcript) }}\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "79f0bcec-77bd-4045-8d61-3bebd5f80a7a",
      "name": "Ajan 1: Rakip Analisti (GPT-4o)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3344,
        816
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agent 1 JSON çıktısını parse et ve transcript bilgilerini taşı\nconst resp = $input.first().json;\nconst raw = resp.choices?.[0]?.message?.content || '{}';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Ajan 1 JSON parse hatası: ' + raw);\n}\n\nconst prev = $('JS: Transcript Budama').item.json;\n\nreturn [{\n  json: {\n    videoId: prev.videoId,\n    videoTitle: prev.videoTitle,\n    channelName: prev.channelName,\n    rakip_tezi: parsed.rakip_tezi || '',\n    toplumsal_itiraz_noktasi: parsed.toplumsal_itiraz_noktasi || ''\n  }\n}];"
      },
      "id": "3eb35a2d-053c-4646-8949-a4d30ada58d4",
      "name": "Parse: Ajan 1 Çıktısı",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3552,
        816
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer OPENAI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.9,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sen kurban psikolojisinden nefret eden, otoriter, 30'lu yaşlarda acımasız bir ilişki mentörüsün. Sana rakip bir 'uzmanın' tezi verilecek. KURALLAR: 1) Rakibin adını/YouTube'u ASLA anma. 2) 'Şu sıralar insanlara sürekli şöyle tavsiyeler veriliyor...' diyerek konuya gir. 3) Onların pasif tezini, soğuk duş etkisi yaratacak sert ve tokat gibi bir manifestoyla çürüt. Sadece manifesto metnini döndür, başka hiçbir şey ekleme.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify('Rakip tezi: ' + $json.rakip_tezi + '\\nToplumsal itiraz noktası: ' + $json.toplumsal_itiraz_noktasi) }}\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "e27e39cd-74f1-4d7b-91d9-a01d80e31628",
      "name": "Ajan 2: Persona Motoru (GPT-4o)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3776,
        816
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agent 2 ham manifesto metnini al, önceki verileri taşı\nconst resp = $input.first().json;\nconst manifesto = resp.choices?.[0]?.message?.content?.trim() || '';\nif (!manifesto) {\n  throw new Error('Ajan 2 boş manifesto döndürdü');\n}\nconst prev = $('Parse: Ajan 1 Çıktısı').item.json;\n\nreturn [{\n  json: {\n    ...prev,\n    manifesto\n  }\n}];"
      },
      "id": "97cf32e2-4afc-49bc-8e22-573667da1082",
      "name": "Parse: Ajan 2 Manifesto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3920,
        592
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer OPENAI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.7,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Bu manifestoyu TikTok/Shorts algoritmaları için kusursuz bir üretim paketine çevir. SADECE şu JSON şemasında Türkçe cevap ver: {\\\"video_hook\\\": string (ilk 3 saniye vurucu başlık), \\\"teleprompter_script\\\": string (kamera ve mimik komutları içeren akıcı senaryo), \\\"caption_hashtags\\\": string (açıklama ve hashtagler), \\\"visual_prompt\\\": string (bu konsepti yansıtacak Midjourney/Flux görsel üretim promptu, İngilizce olabilir)}. Açıklama ekleme.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.manifesto) }}\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "34f1af95-88d3-467e-8e47-a039c9229eca",
      "name": "Ajan 3: Prodüktör (GPT-4o)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4720,
        816
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agent 3 JSON çıktısını parse et, tüm final alanları topla\nconst resp = $input.first().json;\nconst raw = resp.choices?.[0]?.message?.content || '{}';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Ajan 3 JSON parse hatası: ' + raw);\n}\n\nconst prev = $('Parse: Ajan 2 Manifesto').item.json;\n\nreturn [{\n  json: {\n    videoId: prev.videoId,\n    videoTitle: prev.videoTitle,\n    channelName: prev.channelName,\n    rakip_tezi: prev.rakip_tezi,\n    toplumsal_itiraz_noktasi: prev.toplumsal_itiraz_noktasi,\n    manifesto: prev.manifesto,\n    video_hook: parsed.video_hook || '',\n    teleprompter_script: parsed.teleprompter_script || '',\n    caption_hashtags: parsed.caption_hashtags || '',\n    visual_prompt: parsed.visual_prompt || ''\n  }\n}];"
      },
