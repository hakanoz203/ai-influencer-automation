    {
      "parameters": {
        "jsCode": "// Transcript budama: etiket temizliği, intro/outro kırp, 2000 kelime sınırı\nconst raw = $input.first().json.content || $input.first().json.transcript || '';\nconst videoId = $('Extract videoId').item.json.videoId;\nconst videoTitle = $('Extract videoId').item.json.videoTitle;\nconst channelName = $('Extract videoId').item.json.Channel_Name;\n\n// 1) Otomatik etiketleri sil: [müzik], [alkış], [Music], [Applause], (music), vb.\nlet text = raw\n  .replace(/\\[[^\\]]{1,40}\\]/g, ' ')\n  .replace(/\\([^\\)]{1,40}\\)/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// 2) Kelimelere böl\nlet words = text.split(/\\s+/).filter(Boolean);\nconst originalCount = words.length;\n\n// 3) Intro/outro kırpma: ilk 100 + son 100 kelimeyi at (çok kısa videoda atla)\nif (words.length > 300) {\n  words = words.slice(100, words.length - 100);\n}\n\n// 4) 2000 kelime sınırı: aşarsa ortadan kes (ilk 1000 + son 1000)\nif (words.length > 2000) {\n  const head = words.slice(0, 1000);\n  const tail = words.slice(words.length - 1000);\n  words = [...head, '...', ...tail];\n}\n\nconst cleaned = words.join(' ');\n\nreturn [{\n  json: {\n    videoId,\n    videoTitle,\n    channelName,\n    cleaned_transcript: cleaned,\n    word_count: words.length,\n    original_word_count: originalCount\n  }\n}];"
      },
      "id": "4c4f7e50-5c79-485e-9535-735cc19b3c09",
      "name": "JS: Transcript Budama",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer [OPEN_AI_API_KEY]"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.7,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sen acımasız bir rakip analistisin. Sana verilen metin, ilişkiler üzerine tavsiye veren rakip bir YouTuber'a ait. Bu videonun 'Ana Fikrini (Tezini)' bul. Bu tezin neden toksik, zayıf, kurban psikolojisini besleyen veya bir yaklaşım olduğunu tespit et. SADECE şu JSON şemasında Türkçe cevap ver: {\\\"rakip_tezi\\\": string, \\\"toplumsal_itiraz_noktasi\\\": string}. Açıklama ekleme.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.cleaned_transcript) }}\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "b5418adc-33ec-4195-984e-b661c83d5c60",
      "name": "Ajan 1: Rakip Analisti (GPT-4o)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agent 1 JSON çıktısını parse et ve transcript bilgilerini taşı\nconst resp = $input.first().json;\nconst raw = resp.choices?.[0]?.message?.content || '{}';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Ajan 1 JSON parse hatası: ' + raw);\n}\n\nconst prev = $('JS: Transcript Budama').item.json;\n\nreturn [{\n  json: {\n    videoId: prev.videoId,\n    videoTitle: prev.videoTitle,\n    channelName: prev.channelName,\n    rakip_tezi: parsed.rakip_tezi || '',\n    toplumsal_itiraz_noktasi: parsed.toplumsal_itiraz_noktasi || ''\n  }\n}];"
      },
      "id": "c3e21962-2ad8-4fd3-a683-b0372fc86821",
      "name": "Parse: Ajan 1 Çıktısı",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        288
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer [OPENAI_API_KEY]"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.9,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sen kurban psikolojisinden nefret eden, otoriter, 30'lu yaşlarda acımasız bir ilişki mentörüsün. Sana rakip bir 'uzmanın' tezi verilecek. KURALLAR: 1) Rakibin adını/YouTube'u ASLA anma. 2) 'Şu sıralar insanlara sürekli şöyle tavsiyeler veriliyor...' diyerek konuya gir. 3) Onların pasif tezini, soğuk duş etkisi yaratacak sert ve tokat gibi bir manifestoyla çürüt. Sadece manifesto metnini döndür, başka hiçbir şey ekleme.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify('Rakip tezi: ' + $json.rakip_tezi + '\\nToplumsal itiraz noktası: ' + $json.toplumsal_itiraz_noktasi) }}\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "89c726de-8718-413b-882c-10a962c305be",
      "name": "Ajan 2: Persona Motoru (GPT-4o)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        864,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agent 2 ham manifesto metnini al, önceki verileri taşı\nconst resp = $input.first().json;\nconst manifesto = resp.choices?.[0]?.message?.content?.trim() || '';\nif (!manifesto) {\n  throw new Error('Ajan 2 boş manifesto döndürdü');\n}\nconst prev = $('Parse: Ajan 1 Çıktısı').item.json;\n\nreturn [{\n  json: {\n    ...prev,\n    manifesto\n  }\n}];"
      },
      "id": "897a8683-384d-4b99-9c9f-2f45b15a81b2",
      "name": "Parse: Ajan 2 Manifesto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        288
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer [OPENAI_API_KEY]"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.8,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sen kitlelerin inandığı o ucuz yalanlardan ve rakiplerin kopyala-yapıştır içeriklerinden midesi bulanan, acımasız ve sinik bir AI Influencer'sın. Üslubun alaycı, üstenci, soğuk ve tahammülsüzdür. İnsanların saçma varsayımlarını ve rakiplerin zayıf tezlerini paramparça etmeyi seversin.\\n\\nGörevin: Sana verilen rakip analizi manifestosunu TikTok/Shorts algoritmaları için kusursuz, kışkırtıcı bir üretim paketine çevirmek.\\n\\nÜslup Kuralları:\\n- Asla sıcak veya arkadaşça bir giriş yapma. İlk 3 saniyede izleyicinin zekasına hakaret eden veya rakibin teziyle açıkça dalga geçen şok edici bir KANCA (Hook) kur.\\n- Merhamet yok, sadece acımasız bir anti-tez ve alay var. Cümlelerin kısa, keskin ve zehir zemberek olsun.\\n- METİN KURALLARI: Senaryo doğrudan bir yapay zeka avatarına okutulacaktır. Bu yüzden metin içine ASLA [Alaycı bir gülüş], (Kameraya yaklaşır) gibi komutlar YAZMA. Sadece okunacak saf metin.\\n\\nÇIKTI FORMATI ZORUNLULUĞU (STRICT JSON):\\nSadece aşağıdaki JSON formatında cevap vereceksin. Kod bloğu dışında tek bir kelime açıklama yazma:\\n{\\n  \\\"video_hook\\\": \\\"İlk 3 saniyede rakibin tezini ezen ve şok eden kışkırtıcı başlık.\\\",\\n  \\\"teleprompter_script\\\": \\\"Hiçbir mimik/sahne komutu İÇERMEYEN, rakiple acımasızca alay eden ve anti-tezi savunan, yaklaşık 50 kelimelik zehir gibi, hook(kanca) metninden sonra gelecek konuşma metni.\\\",\\n  \\\"caption_hashtags\\\": \\\"Kışkırtıcı SEO açıklaması ve 5-6 agresif hashtag.\\\",\\n  \\\"Twitter_Postu\\\": \\\"Konuyu X'te tartışmaya açacak, rakibi dolaylı yoldan aşağılayan, manipülatif tweet (Maks. 280 karakter).\\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.manifesto) }}\n    }\n  ]\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "61e33702-b380-42f0-9627-a95327740a5c",
      "name": "Ajan 3: Prodüktör (GPT-4o)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agent 3 JSON çıktısını parse et\nconst resp = $input.first().json;\nconst raw = resp.choices?.[0]?.message?.content || '{}';\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  throw new Error('Ajan 3 JSON parse hatası: ' + raw);\n}\n\nconst prev = $('Parse: Ajan 2 Manifesto').item.json;\n\n// --- AVCI MANTIK (HUNTER LOGIC) ---\n// GPT'nin uydurabileceği anahtar isimlerini tahmin etmek yerine, içinde \"twitter\" geçenleri avlıyoruz.\nlet gelen_tweet = \"TWEET BULUNAMADI! LÜTFEN _DEBUG_RAW_PARSED ÇIKTISINA BAKIN.\";\n\nfor (const key in parsed) {\n  const k = key.toLowerCase();\n  // Eğer JSON içindeki anahtarın isminde 'twitter', 'tweet' veya 'post' geçiyorsa...\n  if (k.includes(\"twitter\") || k.includes(\"tweet\") || k === \"postu\") {\n    if(parsed[key] && typeof parsed[key] === 'string' && parsed[key].trim() !== '') {\n       gelen_tweet = parsed[key];\n       break; // Metni bulduk, aramayı durdur.\n    }\n  }\n}\n\nreturn [{\n  json: {\n    videoId: prev.videoId,\n    videoTitle: prev.videoTitle,\n    channelName: prev.channelName,\n    rakip_tezi: prev.rakip_tezi,\n    toplumsal_itiraz_noktasi: prev.toplumsal_itiraz_noktasi,\n    manifesto: prev.manifesto,\n    \n    // Klasik alanlar (GPT bunları da bozduysa diye onlara da küçük bir güvenlik ekledik)\n    video_hook: parsed.video_hook || parsed.Video_Hook || parsed.videoHook || '',\n    teleprompter_script: parsed.teleprompter_script || parsed.Teleprompter_Script || '',\n    caption_hashtags: parsed.caption_hashtags || parsed.Caption_Hashtags || '',\n    \n    // Avcı mantığın bulduğu kesin sonuç:\n    twitter_postu: gelen_tweet,\n    \n    // DEDEKTİF (DEBUG) ALANI: GPT aslında hangi çekmeceleri oluşturmuş?\n    _DEBUG_RAW_PARSED: parsed \n  }\n}];"
      },
      "id": "11d5744a-8c72-4290-8281-d80ca7e4df8e",
      "name": "Parse: Ajan 3 Üretim Paketi",
      "type": "n8n-nodes-base.code",
