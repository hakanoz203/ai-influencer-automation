      "parameters": {
        "jsCode": "// 1. Gelen Veri Kontrolü\nif (items.length === 0) {\n  throw new Error(\"DİKKAT: Veritabanında 'Üretime Hazır' statüsünde hiçbir içerik bulunamadı!\");\n}\n\n// 2. Verileri Düzleştir\nconst allNotionRows = items.map(item => item.json);\n\n// 3. Notion Satırları Arasından Rastgele BİRİNİ Seç\nconst randomRowIndex = Math.floor(Math.random() * allNotionRows.length);\nconst selectedContent = allNotionRows[randomRowIndex];\n\n// 4. Cloudflare R2 Arka Plan Havuzu (Sabit Kalıyor)\nconst r2_backgrounds = [\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B1.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B2.jpeg\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B3.jpeg\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B4.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B5.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B6.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B7.jpeg\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B8.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B9.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B10.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B11.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B12.jpeg\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B13.jpeg\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B14.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B15.png\",\n  \"https://pub-7d03b84a5e2a429daee7ef27de4d76e5.r2.dev/B16.jpeg\"\n];\n\n// 5. HeyGen Avatar Look ID Havuzu (Senin Eklediğin 6 Görünüm)\nconst look_id_pool = [\n  \"55632904d62e419899ae64e4216fcd93\", // Örn: Takım elbiseli\n  \"a13be4e39fb946f78f02f6a83e2f478c\", // Örn: Günlük kıyafet\n  \"37c0be2c53bf4175b986a0aacd050655\", // Örn: Farklı açı\n  \"b9f575ab396541d1bd7fd657d59242e1\",\n  \"369bd754f70748d7bf540c9fa007786e\",\n  \"78739db5418e4e4eba5bdc770b219d11\"\n];\n\n// 6. Rastgele Seçimleri Yap\nconst selected_bg = r2_backgrounds[Math.floor(Math.random() * r2_backgrounds.length)];\nconst selected_look = look_id_pool[Math.floor(Math.random() * look_id_pool.length)];\n\n// 7. Nihai Paketi Döndür\nreturn {\n  notion_id: selectedContent.id, \n  script: selectedContent.property_senaryo, \n  kanca: selectedContent.property_video_kancas, \n  caption_hashtags: selectedContent.property_a_klama, \n  twitter_postu: selectedContent.property_twitter_postu,\n  background_url: selected_bg,\n  active_look_id: selected_look\n};"
      },
